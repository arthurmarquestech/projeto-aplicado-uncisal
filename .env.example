# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do arquivo .env.

PORT=3000
NODE_ENV=production

# Segredo forte para assinatura de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=altere_para_um_segredo_longo_e_aleatorio

# Credenciais do usuário demonstração (apenas no servidor, via ambiente)
DEMO_USERNAME=admin
DEMO_PASSWORD=TroqueEstaSenhaForte123!

# CNES Maceió via DEMAS (IBGE 270430 = Maceió/AL)
CNES_MUNICIPIO_IBGE=270430
CNES_MUNICIPIO_NOME=Maceió
CNES_UF=AL
CNES_FETCH_LIMIT=30
CNES_DISPLAY_LIMIT=8
